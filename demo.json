      {
        "rule_set": "geosite-geolocation-!cn",
        "invert": true,
        "timeout": "300ms",
        "action": "evaluate",
        "server": "aliyun",
        "tag": "cn-doh",
        "speculative": true
      },
      {
        "match_response": "cn-isp",
        "response_rcode": "NOERROR",
        "rule_set": "geoip-cn",
        "ip_accept_any": true,
        "action": "respond",
        "race": true
      },
      {
        "match_response": "cn-doh",
        "response_rcode": "NOERROR",
        "rule_set": "geoip-cn",
        "ip_accept_any": true,
        "action": "respond",
        "race": true
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-geolocation-cn"
        ],
        "match_response": "cn-isp",
        "response_rcode": "NOERROR",
        "ip_accept_any": true,
        "action": "respond",
        "race": true
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-geolocation-cn"
        ],
        "match_response": "cn-doh",
        "response_rcode": "NOERROR",
        "ip_accept_any": true,
        "action": "respond",
        "race": true
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "fakeip"
      }
    ],
    "final": "cloudflare",
    "cache_capacity": 4096,
    "reverse_mapping": true,
    "timeout": "4s",
    "optimistic": {
      "enabled": true,
      "timeout": "1h0m0s"
